option(BINO_STEREO_DESKTOP "Hand native eye pairs to the stereo desktop compositor" ON)
add_compile_definitions(BINO_STEREO_DESKTOP=$<BOOL:${BINO_STEREO_DESKTOP}>)
if(BINO_STEREO_DESKTOP)
    include(${CMAKE_CURRENT_LIST_DIR}/NativeVideo.cmake)
    set(BINO_DISPLAY_SHADER src/shader-display-native.frag.glsl)
    set(BINO_MANUAL "${CMAKE_CURRENT_LIST_DIR}/../doc/bino-manual-stereo-desktop.md")
else()
    set(BINO_DISPLAY_SHADER src/shader-display.frag.glsl)
    set(BINO_MANUAL "${CMAKE_CURRENT_LIST_DIR}/../doc/bino-manual.md")
endif()
